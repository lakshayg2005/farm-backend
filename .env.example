# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=farm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=farm
RABBITMQ_DEFAULT_USER=farm
RABBITMQ_DEFAULT_PASS=change-me
MINIO_ROOT_USER=farm
MINIO_ROOT_PASSWORD=change-me-too
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem

# identity service only
OTP_DEV_MODE=true            # mock SMS: OTP is returned in the API response; must be false in production
EVENTS_ENABLED=true          # set false to run a service without RabbitMQ

# media service: object storage (MinIO / any S3). S3_PUBLIC_ENDPOINT is what browsers and apps
# reach (upload URLs are signed for it); S3_ENDPOINT is what the service uses inside Docker.
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=farm
S3_SECRET_KEY=change-me-too
S3_BUCKET=farm-media
CATALOG_INTERNAL_URL=http://catalog:8000   # media checks photo GPS against farm/plot locations
LAND_INTERNAL_URL=http://land:8000
REDIS_URL=redis://redis:6379/0              # media queues photo jobs here (arq)
JOBS_ENABLED=true                           # media: queue photo processing; the worker is a separate
                                            # container: arq media_service.worker.WorkerSettings
# notification: Android pushes go through FCM. Put the Firebase service-account key (the whole JSON on
# one line) in the real .env or the deploy secrets. NEVER commit it. Empty = Android devices get no push.
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=                             # optional, defaults to project_id inside the JSON
