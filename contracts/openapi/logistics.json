  "info": {
    "title": "logistics service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "ops"
        ]
      }
    },
    "/location": {
      "post": {
        "operationId": "record_location_location_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LocationPingIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Record a GPS location ping (every 30 s while on route)",
        "tags": [
          "logistics"
        ]
      }
    },
    "/my-route": {
      "get": {
        "operationId": "my_route_my_route_get",
        "parameters": [
          {
            "in": "query",
            "name": "pool_date",
            "required": false,
            "schema": {
              "format": "date",
              "title": "Pool Date",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PoolOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Today's assigned pool for the authenticated delivery partner",
        "tags": [
          "logistics"
        ]
      }
    },
    "/offers/mine": {
      "get": {
        "operationId": "my_offers_offers_mine_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/OfferOut"
                  },
                  "title": "Response My Offers Offers Mine Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Open route offers for the signed-in delivery partner",
        "tags": [
          "logistics"
        ]
      }
    },
    "/offers/{pool_id}/accept": {
      "post": {
        "operationId": "accept_route_offer_offers__pool_id__accept_post",
        "parameters": [
          {
            "in": "path",
            "name": "pool_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Pool Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PoolOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "description": "POOL_TAKEN: another partner accepted first"
