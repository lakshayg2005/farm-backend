      "description": "The VM is a container limited to vm_cgroup_cpu_limit_cores CPUs. 'throttled' means work had to wait for CPU.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
