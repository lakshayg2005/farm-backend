{
  "uid": "farm-logs",
  "title": "Farm \u00b7 Logs & traces",
  "description": "Search logs and traces. Click a trace id in a log line to open the trace, and a span to see its logs.",
  "tags": [
    "farm",
    "logs",
    "traces"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(http_server_request_duration_seconds_count, service_name)",
          "refId": "v"
        },
        "definition": "label_values(http_server_request_duration_seconds_count, service_name)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "search",
        "label": "Log text contains",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "level",
        "label": "Level",
        "type": "custom",
        "query": "INFO|WARNING|ERROR|CRITICAL,WARNING|ERROR|CRITICAL,ERROR|CRITICAL",
        "current": {
          "text": "INFO|WARNING|ERROR|CRITICAL",
          "value": "INFO|WARNING|ERROR|CRITICAL"
        },
        "options": [
          {
            "text": "INFO|WARNING|ERROR|CRITICAL",
            "value": "INFO|WARNING|ERROR|CRITICAL",
            "selected": true
          },
          {
            "text": "WARNING|ERROR|CRITICAL",
            "value": "WARNING|ERROR|CRITICAL",
            "selected": false
          },
          {
            "text": "ERROR|CRITICAL",
            "value": "ERROR|CRITICAL",
            "selected": false
          }
        ]
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "farm"
      ],
      "asDropdown": false,
      "title": "Farm dashboards",
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "row",
      "id": 2,
      "title": "Logs",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Log lines by level",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (detected_level) (count_over_time({service_name=~\"$service\"} [$__auto]))",
          "legendFormat": "{{detected_level}}",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "0"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "warn"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 7
      }
    },
    {
      "type": "timeseries",
      "title": "Errors by service",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (service_name) (count_over_time({service_name=~\"$service\", severity_text=~\"ERROR|CRITICAL\"} [$__auto]))",
          "legendFormat": "{{service_name}}",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 7
      }
    },
    {
      "type": "logs",
      "title": "Logs",
      "description": "Newest first. Expand a line and use 'Open trace' to see the whole request.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "{service_name=~\"$service\"} | severity_text=~\"$level\" |= \"$search\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "dedupStrategy": "none"
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 14
      }
    },
    {
      "type": "row",
      "id": 6,
      "title": "Traces",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "nodeGraph",
      "title": "Service map (from traces)",
      "description": "Who calls whom, with request rate and errors, built by Tempo from the spans.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "serviceMap"
        }
      ],
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 12
      }
    },
    {
      "type": "table",
      "title": "Slowest recent requests (over 500 ms)",
      "description": "Click a trace id to open it.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{ span.http.route != nil && duration > 500ms }",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "id": 8,
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 12
      }
    },
    {
      "type": "table",
      "title": "Failed requests and events (errors)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{ status = error }",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 12,
        "h": 10
      }
    },
    {
      "type": "table",
      "title": "Event flows (requests that published events)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{ kind = producer } >> { kind = consumer } | count() > 0",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "id": 10,
      "gridPos": {
        "x": 12,
        "y": 35,
        "w": 12,
        "h": 10
      }
    }
  ]
}
